# Server-side vision recognition. Leave unset for the labeled demo mode
# (on-device comparison with credited reference photographs + manual selection).
# The key is read only by /api/recognition and is never sent to the browser.
# Photographs are not stored after the request.
#
# RECOGNITION_PROVIDER=openai
# RECOGNITION_API_KEY=
# RECOGNITION_MODEL=gpt-4o-mini
# RECOGNITION_BASE_URL=https://api.openai.com/v1
#
# Also supported: google (Gemini) and anthropic.
# RECOGNITION_PROVIDER=google
# RECOGNITION_MODEL=gemini-2.0-flash
# RECOGNITION_PROVIDER=anthropic
# RECOGNITION_MODEL=claude-sonnet-4-5
#
# Map style. Default is OpenFreeMap liberty (vector, OSM-based).
# The app restyles those tiles for the Municipality of Centar.
# Attribution to OpenStreetMap contributors is required.
# OSM raster tiles, the public OSRM demo router, and Google Maps
# directions are rate-limited and are not unlimited production endpoints.
# NEXT_PUBLIC_SITE_URL=https://example.com
#
# Password for the events desk at /admin/events.
# Leave unset and the desk stays closed.
# ADMIN_PASSWORD=
